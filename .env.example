NODE_ENV=production
HOST=127.0.0.1
PORT=3000
BASE_URL=https://bank.example.com
SESSION_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=/var/lib/family-bank/family-bank.sqlite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated allowlist used only at seed time if users table empty
PARENT_EMAIL=
CHILD_EMAIL=
PARENT_NAME=Parent
CHILD_NAME=Child
# Development-only login (disabled unless NODE_ENV=development)
DEV_AUTH_ENABLED=false
TZ=America/Toronto
# Optional GitHub Releases feed for update checks
GITHUB_OWNER=FreezeAnts
GITHUB_REPO=family-bank
