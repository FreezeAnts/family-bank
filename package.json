{
  "name": "family-bank",
  "version": "0.1.0",
  "private": false,
  "description": "Self-hosted family banking app with double-entry ledger",
  "license": "MIT",
  "author": "FreezeAnts",
  "repository": {
    "type": "git",
    "url": "https://github.com/FreezeAnts/family-bank.git"
  },
  "bugs": {
    "url": "https://github.com/FreezeAnts/family-bank/issues"
  },
  "homepage": "https://github.com/FreezeAnts/family-bank#readme",
  "type": "module",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "db:migrate": "node --experimental-sqlite src/db/migrate.js",
    "db:seed": "node --experimental-sqlite src/db/seed.js",
    "test": "node --experimental-sqlite --test tests/*.test.js",
    "release": "pwsh -ExecutionPolicy Bypass -File scripts/publish-release.ps1",
    "release:pack": "pwsh -ExecutionPolicy Bypass -File scripts/publish-release.ps1 -Bump none -SkipPublish"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/csrf-protection": "^7.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.3",
    "node-cron": "^3.0.3",
    "ulid": "^2.3.0"
  }
}
